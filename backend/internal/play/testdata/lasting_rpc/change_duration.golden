## a player
refused permission_denied: only the campaign's master can do this
## a bad key
refused invalid_argument: idempotency_key must be a UUID
## a bad combat id
refused not_found: encounter not found
## a bad effect id
refused not_found: effect not found
## an effect that is not there
refused not_found: effect not found
## a combat that is not there
refused not_found: encounter not found
## rounds 0
refused invalid_argument: duration.rounds must be 1 to 600
## rounds 601
refused invalid_argument: duration.rounds must be 1 to 600
## until the start of a turn with no anchor
refused invalid_argument: duration.anchor_combatant_id is the combatant whose turn ends it
## until the end of a turn with no anchor
refused invalid_argument: duration.anchor_combatant_id is the combatant whose turn ends it
## an anchor that is not an id
refused not_found: combatant not found
## an anchor that is not in the combat
refused not_found: combatant not found
## after the refusals: rows
Brisa condition:prone kind=master conc=false dur=until_dismissed ends=r-/-/- visible=true audience=all label=- caster=-
Brisa spell:bless kind=spell conc=true dur=rounds ends=r11/Pensantus/start_of_turn visible=true audience=owner label=- caster=Pensantus
Goblin spell:hold-person kind=spell conc=true dur=rounds ends=r11/Brisa/start_of_turn visible=true audience=all label=- caster=Brisa
Toren spell:bless kind=spell conc=true dur=rounds ends=r11/Pensantus/start_of_turn visible=true audience=owner label=- caster=Pensantus
