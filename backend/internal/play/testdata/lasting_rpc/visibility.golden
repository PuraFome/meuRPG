## a player
refused permission_denied: only the campaign's master can do this
## a bad key
refused invalid_argument: idempotency_key must be a UUID
## a bad combat id
refused not_found: encounter not found
## a bad effect id
refused not_found: effect not found
## an effect that is not there
refused not_found: effect not found
## a label of 31 characters
refused invalid_argument: player_label must have at most 30 characters
## a label of 31 letters with accents
refused invalid_argument: player_label must have at most 30 characters
## a label of 30 characters between spaces
{
 "effect": {
  "audience": "EFFECT_AUDIENCE_ALL",
  "casterId": "\u003cPensantus\u003e",
  "clockTextPt": "Restam 10 rodadas: acaba no turno de Pensantus, na rodada 11.",
  "concentration": true,
  "durationKind": "EFFECT_DURATION_KIND_ROUNDS",
  "endsAt": {
   "combatantId": "\u003cPensantus\u003e",
   "phase": "EFFECT_PHASE_START",
   "round": 11
  },
  "id": "\u003cfx:spell:bless@Brisa+Toren\u003e",
  "playerLabel": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "playerVisible": true,
  "roundsLeft": 10,
  "sourceKey": "spell:bless",
  "targetLabels": [
   "Brisa",
   "Toren"
  ]
 }
}
## after the refusals: rows
Brisa condition:prone kind=master conc=false dur=until_dismissed ends=r-/-/- visible=true audience=all label=- caster=-
Brisa spell:bless kind=spell conc=true dur=rounds ends=r11/Pensantus/start_of_turn visible=true audience=all label=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa caster=Pensantus
Goblin spell:hold-person kind=spell conc=true dur=rounds ends=r11/Brisa/start_of_turn visible=true audience=all label=- caster=Brisa
Toren spell:bless kind=spell conc=true dur=rounds ends=r11/Pensantus/start_of_turn visible=true audience=all label=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa caster=Pensantus
## after the refusals: events
lasting_effect_visibility_changed by <user:master> {"combatant_id":"<Pensantus>","lasting":{"change":"visibility","effects":["<fx:spell:bless@Brisa+Toren>"],"key":"spell:bless"},"round":1,"secret":true,"target_id":"<a row of the casting>"}
