# Every text file is stored and checked out with LF line endings (git
# detects binaries by itself).
* text=auto eol=lf

# Generated code is collapsed in pull request diffs and left out of the
# language statistics. Review the .proto files, queries.sql and the importer
# instead; CI regenerates all of it and fails on any difference.
backend/gen/** linguist-generated=true
web/src/gen/** linguist-generated=true
backend/internal/*/*db/*.go linguist-generated=true
# The SRD 5.1 snapshot, generated by backend/cmd/srdimport (see
# data/manifest.json).
backend/internal/rules/srd51/data/*.json linguist-generated=true
