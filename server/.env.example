# Environment variables required for the meuRPG backend
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql://postgres:postpass@host.docker.internal:26257/db?sslmode=disable

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Application
# Most PaaS (Render) inject PORT automatically; API_PORT is the local fallback.
API_PORT=3000
NODE_ENV=development

# CORS: comma-separated origins only (scheme + host, no path).
FRONTEND_ORIGIN=http://localhost:4200,https://purafome.github.io

# OAuth bounce-back target (the SPA URL). Needed when the app is served from a
# sub-path such as GitHub Pages /meuRPG/. Defaults to the first FRONTEND_ORIGIN.
FRONTEND_REDIRECT_URL=http://localhost:4200/

# Public URL of THIS API → Google redirect_uri is
# ${API_PUBLIC_URL}/api/auth/callback. On Render it auto-falls back to
# RENDER_EXTERNAL_URL when left empty.
API_PUBLIC_URL=http://localhost:3000
