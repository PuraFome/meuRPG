# MeuRPG ELK stack: copy to .env (or let `make elk-up` do it: it runs init-env.sh,
# which fills every value below with a random one). .env is gitignored.
# Use only letters, digits and . _ ~ + = - in passwords (the setup script rejects the rest).

# Superuser of Elasticsearch and Kibana. Keep it out of scripts that only read logs.
ELASTIC_PASSWORD=change-me-elastic
# Internal user Kibana uses to talk to Elasticsearch.
KIBANA_PASSWORD=change-me-kibana
# meurpg_filebeat: can only write to logs-meurpg-* (used by Filebeat).
FILEBEAT_PASSWORD=change-me-filebeat
# meurpg_reader: can only read logs-meurpg-* (used by logs.sh and by agents that watch the logs).
READER_PASSWORD=change-me-reader
# 32+ characters; encrypts saved objects, sessions and reports in Kibana (openssl rand -hex 32).
KIBANA_ENCRYPTION_KEY=change-me-change-me-change-me-change-me

# Optional.
# ES_PORT=9200
# KIBANA_PORT=5601
# Where the native stack keeps api.log (deploy/local/native.sh); mounted read-only into Filebeat.
# MEURPG_HOME=/Users/you/.meurpg
